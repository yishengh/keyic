    <!-- Onboarding -->
    <string name="onboarding_get_started">Empezar</string>
    <string name="onboarding_page_indicator">%1$d / %2$d</string>
    <string name="onboarding_title_1">Sin conexión por diseño</string>
    <string name="onboarding_body_1">Tu bóveda se cifra en este dispositivo con Argon2id y AES-GCM. Keyic nunca usa la red: los secretos se quedan en local.</string>
    <string name="onboarding_title_2">Captura con la cámara</string>
    <string name="onboarding_body_2">Escanea QR de TOTP, Wi‑Fi, tarjetas e identidad para rellenar entradas en segundos. Todo se procesa en el dispositivo.</string>
    <string name="onboarding_title_3">Autocompletar y 2FA</string>
    <string name="onboarding_body_3">Activa Keyic como servicio de Autocompletar para rellenar inicios de sesión. Si hay 2FA, el código queda listo tras rellenar; Auth muestra códigos con un toque.</string>
    <string name="onboarding_title_4">Copia de seguridad sin cuenta</string>
    <string name="onboarding_body_4">Elige una carpeta de Drive, OneDrive o local. Keyic escribe un archivo .keyic cifrado; tu nube sincroniza solo el texto cifrado. Etiquetas, salud y el generador mantienen la bóveda ordenada.</string>

